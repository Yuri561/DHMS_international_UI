# DHMS International — Frontend environment (example)
#
# Copy this file to `.env` and fill in real values.
# Only VITE_-prefixed variables are exposed to the browser. Never put
# backend secrets (Stripe secret key, Brevo API key, Mongo URI, etc.) here.

# API base URL. No trailing slash.
# Production example: https://api.dhmsint.com
# Local backend example: http://localhost:8080
VITE_API_URL=https://api.dhmsint.com

# Support email shown on the order-confirmation page as a mailto link.
VITE_SUPPORT_EMAIL=dhmsint@gmail.com
