########################################
# DHMS International — Backend env sample
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` to source control.
########################################

PORT=8080

# Set to "production" when deploying so cookies get SameSite=None + Secure.
NODE_ENV=development

# ---------- Mongo ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# Optional: override the database name parsed out of the URI path.
# MONGODB_DB_NAME=dhmsDb

# ---------- Session / Auth ----------
SESSION_SECRET=change-me
JWT_KEY=change-me
GOOGLE_CLIENT_ID=

# ---------- Stripe ----------
STRIPE_KEY=sk_test_or_live_key_here
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_dashboard

# ---------- Client / URLs ----------
CLIENT_URL=http://localhost:5173/
FRONTEND_URL=https://dhmsint.com
RESET_LINK=https://dhms-client.vercel.app/reset-password

# ---------- Email (Brevo) ----------
# Get an API key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key
# Must be a verified sender/domain on Brevo
BREVO_SENDER_EMAIL=orders@dhmsint.com
BREVO_SENDER_NAME=DHMS International

# Mailbox that receives internal order notifications
ADMIN_EMAIL=dhmsint@gmail.com

# Optional: contact form recipient
CONTACT_RECIPIENT_EMAIL=dhmsint@gmail.com
